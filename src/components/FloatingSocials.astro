---

<div class="social-button" aria-label="Быстрая связь в мессенджерах">
  <input
    type="checkbox"
    class="social-open"
    name="social-open"
    id="social-open"
    aria-label="Открыть контакты мессенджеров"
  />
  <label
    class="social-open-button"
    for="social-open"
    title="Написать нам в мессенджер"
  >
    <span></span>
  </label>
  <a
    href="https://max.ru/u/f9LHodD0cOKVE5qofs_rxTYqArSbNOWAMh5acGm-JdIQJTRyQVCBrugo8Zk"
    class="social-link max"
    title="Написать в Max"
    target="_blank"
    rel="noopener noreferrer"
  ></a>
  <a
    href="https://t.me/"
    class="social-link telegram"
    title="Написать в Telegram"
    target="_blank"
    rel="noopener noreferrer"
  ></a>
  <a
    href="https://vk.com/"
    class="social-link vkontakte"
    title="Мы ВКонтакте"
    target="_blank"
    rel="noopener noreferrer"
  ></a>
</div>

<style>
  .social-button,
  .social-open {
    display: none;
  }

  @media (max-width: 768px) {
    .social-button {
      display: block;
      position: fixed;
      right: 20px;
      bottom: 25px;
      z-index: 40;
    }
  }

  .social-open-button {
    position: relative;
    display: block;
    width: 50px;
    height: 50px;
    cursor: pointer;
  }

  .social-open-button > span {
    position: absolute;
    inset: 0;
    background: url(/images/icons/message.svg) center / 24px no-repeat;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    z-index: 2;
    transition: transform var(--transition-speed);
  }

  .social-open-button:hover > span {
    transform: scale(1.06);
  }

  .social-open-button::before {
    content: "";
    position: absolute;
    inset: -4px;
    border: 2px solid var(--color-btn);
    border-radius: 50%;
    animation: wave 3.5s infinite ease-out;
  }

  @keyframes wave {
    0% {
      transform: scale(0.85);
      opacity: 1;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .social-open:checked + .social-open-button > span {
    transform: scale(0.9);
  }

  .social-open:checked + .social-open-button::before {
    display: none;
  }

  .social-link {
    position: absolute;
    top: 5px;
    left: 5px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition:
      transform var(--transition-speed) cubic-bezier(0.175, 0.885, 0.32, 1.275),
      opacity var(--transition-speed);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .social-link.telegram {
    background: url(/images/icons/telegram.svg) center / cover no-repeat;
  }

  .social-link.max {
    background: url(/images/icons/max.svg) center / cover no-repeat;
  }

  .social-link.vkontakte {
    background: url(/images/icons/vk.svg) center / cover no-repeat;
  }

  .social-open:checked ~ .social-link {
    opacity: 1;
    pointer-events: auto;
  }

  .social-open:checked ~ .social-link.max {
    transform: translateY(-55px);
  }

  .social-open:checked ~ .social-link.telegram {
    transform: translateY(-110px);
  }

  .social-open:checked ~ .social-link.vkontakte {
    transform: translateY(-165px);
  }
</style>
